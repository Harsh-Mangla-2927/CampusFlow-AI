# ============================================================
# CAMPUSFLOW AI — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CLIENT_URL=http://localhost:5173

# ============================================================
# EDUCATIONAL EMAIL DOMAIN ALLOWLIST
# Comma-separated list of allowed educational email domains.
# Example: chitkara.edu.in,chitkara.ac.in,lpu.edu.in
# Leave blank to allow any email (NOT recommended for production).
# ============================================================
ALLOWED_EMAIL_DOMAINS=chitkara.edu.in,chitkara.ac.in

# ============================================================
# OTP / EMAIL SERVICE
# Provider: nodemailer (SMTP)
# Fill these to enable real OTP email verification.
# If left blank, OTP verification is DISABLED and registration
# proceeds without email verification.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=CampusFlow AI <noreply@campusflow.ai>

# OTP settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================================
# CODE BRIGADE INTEGRATION (DISABLED — See Architecture Notes)
# Official Chitkara/Code Brigade API integration.
# Only enable when an official authorized API/OAuth is available.
# ============================================================
# CODE_BRIGADE_ENABLED=false
# CODE_BRIGADE_API_URL=
# CODE_BRIGADE_CLIENT_ID=
# CODE_BRIGADE_CLIENT_SECRET=
